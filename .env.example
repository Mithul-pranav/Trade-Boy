# Copy to .env for local runs. Never commit the real file.
OANDA_API_TOKEN=
# Optional: if empty, the only account on the token is used
OANDA_ACCOUNT_ID=
# practice (demo) or live
OANDA_ENV=practice
# Claude API key for the agents
# Cloud environments reserve ANTHROPIC_API_KEY, so use this name there (ANTHROPIC_API_KEY also works locally)
TRADEBOY_ANTHROPIC_API_KEY=
# Telegram alerts (optional). The chat ID is found automatically after you message the bot.
TRADEBOY_TELEGRAM_BOT_TOKEN=
TRADEBOY_TELEGRAM_CHAT_ID=
# Tech stocks desk: Alpaca PAPER trading keys (alpaca.markets, Paper Trading, Generate API keys)
TRADEBOY_ALPACA_KEY_ID=
TRADEBOY_ALPACA_SECRET_KEY=
# SEC EDGAR wants a contact in every script's User-Agent, e.g. "Trade-Boy you@example.com"
TRADEBOY_SEC_USER_AGENT=
